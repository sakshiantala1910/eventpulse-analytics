PORT=8000
# Comma-separated list of origins allowed to call this API from a browser.
# Add a LAN IP here too if you're testing the frontend from another device.
FRONTEND_URL=http://localhost:3000

# Where this backend is reachable at. Used for: (1) the startup log message,
# and (2) OrdersService calling back into its own ingestion API via the
# server SDK to fire `order_created`. Must match PORT above.
EVENTPULSE_BACKEND_URL=http://localhost:8000

# Relative to the backend/ directory, or the literal string ":memory:"
# (used by the e2e test suite for an isolated, disposable database).
DB_PATH=database/eventpulse.sqlite

# Two separate keys so a leaked dashboard (read) key can't write events,
# and a leaked ingest (write) key can't read analytics data.
EVENTPULSE_INGEST_API_KEY=local-dev-ingest-key
EVENTPULSE_DASHBOARD_API_KEY=local-dev-dashboard-key

EVENTPULSE_MAX_BATCH_SIZE=50
