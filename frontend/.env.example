# Copy this file to .env.local and adjust as needed:
#   cp .env.example .env.local
#
# Values below line up with backend/.env.example, so the default local setup
# (backend on :8000, frontend on :3000) works without edits.

# --- Browser-side (NEXT_PUBLIC_*, exposed in the client bundle) ---

# Where the browser sends analytics events. Must match the backend's
# EVENTPULSE_BACKEND_URL / PORT, and be listed in the backend's FRONTEND_URL
# CORS allow-list.
NEXT_PUBLIC_EVENTPULSE_API_HOST=http://localhost:8000

# Write-only ingest key. Must match EVENTPULSE_INGEST_API_KEY in backend/.env.
# This ships to the browser by design — it can only write events, never read
# analytics data. Never put the dashboard key here.
NEXT_PUBLIC_EVENTPULSE_INGEST_API_KEY=local-dev-ingest-key

# --- Server-side only (never exposed to the browser) ---

# Used by lib/analytics.ts for server-side dashboard queries.
EVENTPULSE_BACKEND_URL=http://localhost:8000

# Read key for analytics data. Must match EVENTPULSE_DASHBOARD_API_KEY in
# backend/.env. Keep this un-prefixed so it stays out of the client bundle.
EVENTPULSE_DASHBOARD_API_KEY=local-dev-dashboard-key

# --- Optional ---

# Comma-separated extra origins allowed to reach the dev server, for opening
# the app from another device on your LAN (e.g. http://192.168.1.50:3000).
# Leave empty for plain localhost development.
NEXT_DEV_ALLOWED_ORIGINS=
